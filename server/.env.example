# # Required API configuration
# CLIENT_URL=http://localhost:5173
# DbURL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# # Generate a random secret with at least 32 characters; this placeholder is invalid.
# JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# AWS_REGION=YOUR_AWS_REGION
# AWS_S3_BUCKET_NAME=YOUR_S3_BUCKET

# # Comma-separated email addresses provisioned as administrators outside public registration.
# ADMIN_EMAILS=

# # Optional Redis settings (defaults to 127.0.0.1:6379)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# # Required when starting the email worker
# SMTP_USER=YOUR_BREVO_SMTP_USER
# SMTP_PASS=YOUR_BREVO_SMTP_KEY
# SENDER_EMAIL=YOUR_VERIFIED_SENDER_ADDRESS

# Optional Razorpay checkout; configure both together to enable online payments.


# # Optional application settings
# PORT=5000
# LOW_STOCK_THRESHOLD=5
# NODE_ENV=development
# # Seeding also requires NODE_ENV=development and ALLOW_SEED=true.
# ALLOW_SEED=false

# # Compose-only local database settings (not read by the API process)
# DbPort=5432
# DbPassword=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD

COMPOSE_FILE=compose.prod.yaml
DOMAIN=yourname.duckdns.org
DbPassword=change-me
