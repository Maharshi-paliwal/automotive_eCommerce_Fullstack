generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @db.Uuid
  name      String?
  email     String? @unique
  password  String?
  phone     String? @default("")
  avatar    String? @default("")

  addresses Address[]
  orders    Order[]
  inventoryMovements InventoryMovement[] @relation("InventoryActor")
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  complaints Complaint[]

  createdAt DateTime? @default(now()) @db.Timestamp(3)
  updatedAt DateTime? @updatedAt @db.Timestamp(3)
}

model Address {
  id String @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  isDefault Boolean? @default(false)
  lat       Float?
  lng       Float?

  createdAt DateTime? @default(now()) @db.Timestamp(3)
  updatedAt DateTime? @updatedAt @db.Timestamp(3)

  @@index([userId, createdAt])
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  name              String?
  brand             String?
  description       String?  @default("")
  price             Float?
  originalPrice     Float?   @default(0)
  image             String?
  category          String?
  unit              String?  @default("piece")
  stock             Int?     @default(0)
  isOrganic         Boolean? @default(false)
  iGenuine          Boolean? @default(false)
  compatibleVehicles String[] @default([])
  partNumber        String?
  rating            Float?   @default(0)
  reviewCount       Int?     @default(0)
  inventoryMovements InventoryMovement[]

  createdAt DateTime? @default(now()) @db.Timestamp(3)
  updatedAt DateTime? @updatedAt @db.Timestamp(3)

  @@index([stock, originalPrice])
}

model Order {
  id                String  @id @db.Uuid

  userId            String? @db.Uuid
  user              User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items             Json?
  shippingAddress   Json?
  paymentMethod     String?  @default("card")
  subtotal          Float?
  deliveryFee       Float?   @default(0)
  tax               Float?
  total             Float?
  status            String?  @default("Placed")
  statusHistory     Json?

    deliveryPartnerId String? @db.Uuid
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  deliveryOtp  String?  @default("")
  liveLocation Json?
  isPaid       Boolean? @default(false)
  razorpayOrderId String? @unique
  razorpayPaymentId String? @unique
  paymentStatus String? @default("pending")
  paymentReceivedAt DateTime? @db.Timestamp(3)
  refundId String? @unique
  refundStatus String?
  refundAmount Int?
  refundIdempotencyKey String?
  refundRequestedAt DateTime? @db.Timestamp(3)
  refundProcessedAt DateTime? @db.Timestamp(3)
  refundAttempts Int @default(0)
  refundLastError String?

  refundAttemptRecords RefundAttempt[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime? @default(now()) @db.Timestamp(3)
  updatedAt DateTime? @updatedAt @db.Timestamp(3)

  @@index([userId, createdAt])
  @@index([deliveryPartnerId, status, createdAt])
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  dedupeKey String @unique
  queue String
  jobName String
  payload Json
  availableAt DateTime @default(now()) @db.Timestamp(3)
  lockedUntil DateTime? @db.Timestamp(3)
  leaseToken String?
  processedAt DateTime? @db.Timestamp(3)
  attempts Int @default(0)
  jobGeneration Int @default(0)
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([processedAt, availableAt])
}

model RefundAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptNumber Int
  paymentId String
  refundId String? @unique
  idempotencyKey String @unique
  amount Int
  status String @default("pending")
  requestedAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)
  processedAt DateTime? @db.Timestamp(3)
  lastError String?

  @@unique([orderId, attemptNumber])
  @@index([orderId, status])
}

model WebhookEvent {
  eventId String @id
  event String
  receivedAt DateTime @default(now()) @db.Timestamp(3)
  processedAt DateTime? @db.Timestamp(3)
}

model DeliveryPartner {
  id String @id @default(uuid()) @db.Uuid
  name        String?
  email       String? @unique
  password    String?
  phone       String?
  avatar      String? @default("")
  vehicleType String? @default("bike")
  isActive    Boolean? @default(true)

  orders Order[]

  createdAt DateTime? @default(now()) @db.Timestamp(3)
  updatedAt DateTime? @updatedAt @db.Timestamp(3)
}

enum InventoryMovementType {
  INITIAL_STOCK
  ORDER_DEDUCTION
  MANUAL_ADJUSTMENT
  ORDER_CANCELLATION_RESTORATION
  UNPAID_ORDER_EXPIRY_RESTORATION
}

model InventoryMovement {
  id               String               @id @default(uuid()) @db.Uuid
  productId        String?              @db.Uuid
  product          Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  movementType     InventoryMovementType
  quantityChange   Int?
  stockBefore      Int?
  stockAfter       Int?
  reason           String
  adminActorId     String?              @db.Uuid
  adminActor       User?                @relation("InventoryActor", fields: [adminActorId], references: [id], onDelete: SetNull)
  relatedOrderId   String?              @db.Uuid
  relatedOrder     Order?               @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now()) @db.Timestamp(3)

  @@index([productId, createdAt])
  @@index([relatedOrderId, movementType])
}

enum NotificationType {
  LOW_STOCK
  PAYMENT_FAILED
  CUSTOMER_COMPLAINT
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  message         String
  referenceType   String?
  referenceId     String?
  readAt          DateTime?        @db.Timestamp(3)
  idempotencyKey  String
  createdAt       DateTime         @default(now()) @db.Timestamp(3)

  @@unique([userId, idempotencyKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)
}

enum ComplaintCategory {
  ORDER
  PRODUCT
  PAYMENT
  DELIVERY
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Complaint {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       ComplaintCategory
  subject        String
  description    String
  status         ComplaintStatus   @default(OPEN)
  idempotencyKey String
  createdAt      DateTime          @default(now()) @db.Timestamp(3)
  updatedAt      DateTime          @updatedAt @db.Timestamp(3)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
